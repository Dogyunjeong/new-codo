# Firebase Configuration - Production
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyProduction-XXXXXXXXXXXXX
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=ziririt-prod.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=ziririt-prod
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=ziririt-prod.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=345678901234
EXPO_PUBLIC_FIREBASE_APP_ID=1:345678901234:ios:cdefgh345678
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-ZZZZZZZZZZ

# OAuth Client IDs - Production
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=345678901234-prod.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=345678901234-ios-prod.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=345678901234-android-prod.apps.googleusercontent.com
EXPO_PUBLIC_APPLE_SERVICE_ID=com.ziririt.app.signin

# Backend Service URLs - Production Environment (All through API Gateway)
EXPO_PUBLIC_API_GATEWAY_URL=https://api.ziririt.com
EXPO_PUBLIC_AUTH_SERVICE_URL=https://api.ziririt.com
EXPO_PUBLIC_PROFILE_SERVICE_URL=https://api.ziririt.com
EXPO_PUBLIC_POST_SERVICE_URL=https://api.ziririt.com
EXPO_PUBLIC_FEED_SERVICE_URL=https://api.ziririt.com

# Feature Flags
EXPO_PUBLIC_ENABLE_GOOGLE_LOGIN=true
EXPO_PUBLIC_ENABLE_APPLE_LOGIN=true
EXPO_PUBLIC_ENABLE_EMAIL_LOGIN=true
EXPO_PUBLIC_ENABLE_BIOMETRIC_AUTH=true
EXPO_PUBLIC_ENABLE_ANALYTICS=true

# App Configuration
EXPO_PUBLIC_APP_NAME=Ziririt
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_API_TIMEOUT=15000
EXPO_PUBLIC_MAX_RETRY_ATTEMPTS=3

# Debug Settings
EXPO_PUBLIC_DEBUG_MODE=false
EXPO_PUBLIC_LOG_LEVEL=error
