# Firebase Configuration - Staging
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyStaging-XXXXXXXXXXXXX
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=ziririt-staging.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=ziririt-staging
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=ziririt-staging.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=234567890123
EXPO_PUBLIC_FIREBASE_APP_ID=1:234567890123:ios:bcdefg234567
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-YYYYYYYYYY

# OAuth Client IDs - Staging
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=234567890123-staging.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=234567890123-ios-staging.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=234567890123-android-staging.apps.googleusercontent.com
EXPO_PUBLIC_APPLE_SERVICE_ID=com.ziririt.app.signin.staging

# Backend Service URLs - Staging Environment (All through API Gateway)
EXPO_PUBLIC_API_GATEWAY_URL=https://staging-api.ziririt.com
EXPO_PUBLIC_AUTH_SERVICE_URL=https://staging-api.ziririt.com
EXPO_PUBLIC_PROFILE_SERVICE_URL=https://staging-api.ziririt.com
EXPO_PUBLIC_POST_SERVICE_URL=https://staging-api.ziririt.com
EXPO_PUBLIC_FEED_SERVICE_URL=https://staging-api.ziririt.com

# Feature Flags
EXPO_PUBLIC_ENABLE_GOOGLE_LOGIN=true
EXPO_PUBLIC_ENABLE_APPLE_LOGIN=true
EXPO_PUBLIC_ENABLE_EMAIL_LOGIN=true
EXPO_PUBLIC_ENABLE_BIOMETRIC_AUTH=true
EXPO_PUBLIC_ENABLE_ANALYTICS=true

# App Configuration
EXPO_PUBLIC_APP_NAME=Ziririt Staging
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_API_TIMEOUT=20000
EXPO_PUBLIC_MAX_RETRY_ATTEMPTS=3

# Debug Settings
EXPO_PUBLIC_DEBUG_MODE=true
EXPO_PUBLIC_LOG_LEVEL=info
