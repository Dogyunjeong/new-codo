{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@base/shared-api-controllers": ["../packages/shared-api-controllers/src"],
      "@base/shared-api-controllers/*": ["../packages/shared-api-controllers/src/*"],
      "@base/server-services": ["../packages/server-services/src"],
      "@base/server-services/*": ["../packages/server-services/src/*"],
      "@base/shared-types": ["../packages/shared-types/src"],
      "@base/shared-types/*": ["../packages/shared-types/src/*"]
    },
    "types": ["vitest/globals", "node"]
  },
  "include": ["**/*.ts", "**/*.mts", "**/*.tsx", "**/*.vue"]
}
