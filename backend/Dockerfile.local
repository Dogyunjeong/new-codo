#build
FROM node:22-alpine
ARG BUILD_CONTEXT

WORKDIR /base
COPY package.json yarn.lock .yarnrc.yml tsconfig.json ./
COPY .yarn ./.yarn
COPY ./packages ./packages
COPY ./$BUILD_CONTEXT/ ./$BUILD_CONTEXT/
COPY ./backend/ecosystem.config.cjs ./backend/ecosystem.config.cjs
RUN yarn set version berry

WORKDIR /base/$BUILD_CONTEXT
RUN yarn install --network-timeout 1000000

# Install tsx globally and pm2 for services that need runtime TypeScript
RUN npm install -g tsx pm2

# Try to build, but continue if it fails for feed service
RUN if [ "$BUILD_CONTEXT" = "backend/ziririt-feed-service" ]; then \
      echo "Skipping build for feed service, running with tsx"; \
    else \
      yarn build; \
    fi

CMD ["pm2-runtime", "start", "ecosystem.config.cjs"]