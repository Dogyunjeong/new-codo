{
  "name": "ziririt-post-service",
  "version": "1.0.0",
  "description": "Post service for Ziririt Journey Sharing App - Handles progress posts, media uploads, likes, and comments",
  "packageManager": "yarn@4.0.2",
  "type": "module",
  "scripts": {
    "build": "tsup-node",
    "start": "pm2 start ecosystem.config.cjs",
    "start:prod": "pm2 start ecosystem.config.cjs --env production",
    "stop": "pm2 stop ecosystem.config.cjs",
    "dev": "tsup-node --watch --sourcemap inline --onSuccess 'node dist/index.js'",
    "dev:build": "tsup-node --watch --sourcemap",
    "dev:run": "NODE_OPTIONS='--enable-source-maps' nodemon dist/index.js --watch dist",
    "dev:watch": "yarn install && concurrently \"yarn dev:build\" \"yarn dev:run\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@base/server-base": "workspace:*",
    "@base/server-services": "workspace:*",
    "@base/shared-api-controllers": "workspace:*",
    "@base/shared-types": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.0.0",
    "dotenv": "^16.5.0",
    "fastify": "^4.28.1",
    "mongodb": "^6.3.0",
    "pm2": "^6.0.5",
    "sharp": "^0.33.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/uuid": "^9.0.8",
    "concurrently": "^9.1.2",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "tsx": "^4.19.3"
  }
}
