{
  "node-option": ["experimental-specifier-resolution=node", "loader=ts-node/esm"],
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "composite": true,
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "outDir": "./dist",
    "resolveJsonModule": true
  },
  "include": ["src", "src/**/*.json"]
}
