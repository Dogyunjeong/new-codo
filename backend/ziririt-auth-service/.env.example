# GCP Identity Platform Configuration
GCP_PROJECT_ID=ziririt-dev
GCP_API_KEY=your-gcp-api-key-here

# Firebase Service Account (for Admin SDK)
# Get these from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=ziririt-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@ziririt-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# JWT Configuration (for backend tokens)
JWT_SECRET=your-secure-jwt-secret-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-secure-refresh-secret-min-32-chars-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database
DATABASE_URL=postgresql://ziririt_user:ziririt_password@localhost:5432/ziririt_db

# Service Configuration
PORT=4101
SERVICE_NAME=ziririt-auth-service
NODE_ENV=development
LOG_LEVEL=info

# OAuth Configuration (optional, for future use)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
APPLE_CLIENT_ID=com.ziririt.app
APPLE_TEAM_ID=your-apple-team-id
APPLE_PRIVATE_KEY_ID=your-apple-private-key-id
APPLE_PRIVATE_KEY=your-apple-private-key