{
  "name": "ziririt-auth-service",
  "version": "1.0.0",
  "type": "module",
  "description": "Authentication service for Ziririt Journey Sharing App - Handles OAuth and JWT authentication",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup-node",
    "start": "pm2 start ecosystem.config.cjs",
    "start:prod": "pm2 start ecosystem.config.cjs --env production",
    "stop": "pm2 stop ecosystem.config.cjs",
    "dev": "tsup-node --watch --sourcemap inline --onSuccess 'node dist/index.js'",
    "dev:build": "tsup-node --watch --sourcemap",
    "dev:run": "NODE_OPTIONS='--enable-source-maps' nodemon dist/index.js --watch dist",
    "dev:watch": "yarn install && concurrently \"yarn dev:build\" \"yarn dev:run\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist",
    "migrate": "node dist/utils/migrate.js"
  },
  "dependencies": {
    "@base/server-base": "workspace:*",
    "@base/server-services": "workspace:*",
    "@base/shared-api-controllers": "workspace:*",
    "@base/shared-types": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.28.1",
    "firebase-admin": "^13.4.0",
    "google-auth-library": "^9.6.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.17",
    "@types/pg": "^8.10.9",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "authentication",
    "oauth",
    "jwt",
    "fastify",
    "postgresql"
  ],
  "author": "Ziririt Team",
  "license": "MIT"
}
