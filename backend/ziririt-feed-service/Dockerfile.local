FROM node:22-alpine

WORKDIR /app

# Install tsx for TypeScript execution
RUN npm install -g tsx

# Copy package files for dependencies
COPY package.json ./

# Install dependencies
RUN npm install

# Install required packages
RUN npm install fastify mongodb

# Copy source code
COPY src ./src

# Expose port
EXPOSE 4104

# Start the service directly with tsx
CMD ["tsx", "src/index.mts"]