{
  "name": "ziririt-feed-service",
  "version": "1.0.0",
  "description": "Feed generation and caching service for Ziririt",
  "main": "dist/index.mjs",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext mts,mjs,json --exec 'npm run build && npm start'",
    "build": "tsc",
    "start": "node dist/index.mjs",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@base/shared-controllers": "workspace:*",
    "@base/shared-services": "workspace:*",
    "@base/shared-types": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "@fastify/swagger": "^9.4.1",
    "@fastify/swagger-ui": "^5.2.0",
    "fastify": "^5.2.1",
    "mongodb": "^6.12.0",
    "pm2": "^6.0.5",
    "redis": "^4.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "nodemon": "^3.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
