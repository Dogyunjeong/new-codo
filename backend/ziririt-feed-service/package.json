{
  "name": "ziririt-feed-service",
  "version": "1.0.0",
  "description": "Feed generation and caching service for Ziririt",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsup-node",
    "start": "pm2 start ecosystem.config.cjs",
    "start:prod": "pm2 start ecosystem.config.cjs --env production",
    "stop": "pm2 stop ecosystem.config.cjs",
    "dev": "tsup-node --watch --sourcemap inline --onSuccess 'node dist/index.js'",
    "dev:build": "tsup-node --watch --sourcemap",
    "dev:run": "NODE_OPTIONS='--enable-source-maps' nodemon dist/index.js --watch dist",
    "dev:watch": "yarn install && concurrently \"yarn dev:build\" \"yarn dev:run\"",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@base/server-base": "workspace:*",
    "@base/server-services": "workspace:*",
    "@base/shared-api-controllers": "workspace:*",
    "@base/shared-types": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "@fastify/swagger": "^9.4.1",
    "@fastify/swagger-ui": "^5.2.0",
    "fastify": "^5.2.1",
    "mongodb": "^6.12.0",
    "pm2": "^6.0.5",
    "redis": "^4.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.1.2",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "tsup": "^8.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
